# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and as the default content-import target. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional override for the content-import target (for example, https://www.dannymoons.nl)
# CONTENT_IMPORT_URL=

# Secret used to authenticate cron jobs and content imports
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional: target a wrangler environment (e.g. staging)
# CLOUDFLARE_ENV=
